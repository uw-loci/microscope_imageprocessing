# Large test data -- real microscopy images should be small or synthetic.
# Keep committed test data under 100KB per file.
# Real TIFF images for integration tests belong in tests/data/ but
# exclude anything over 1MB.
tests/data/*.tif
!tests/data/synthetic_*.tif
!tests/data/small_*.tif

